{% extends 'base.html.twig' %}

{% block title %}Refuge new{% endblock %}

{% block body %}
<h1>Nouveau refuge</h1>

{{ form_start(form) }}
    {{ form_row(form.nom) }}
    {{ form_row(form.address) }}
    <div class="mt-4 mb-4">
        <label>Sélectionner une plage de réservation</label>
        <div class="flex gap-1.5">
            <calendar-range id="reservationFromCalendar" class="cally bg-base-100 border border-base-300 shadow-lg rounded-box p-4">
                <calendar-month></calendar-month>
                <calendar-month offset="1"></calendar-month>
            </calendar-range>
        </div>
    </div>

    {% set errors = form_errors(form.reservations[0].dateStart) %}

    {% if errors is not empty %}
        <div role="alert" class="alert alert-error">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{{ form_errors(form.reservations[0].dateStart) }}</span>
        </div>
    {% endif %}

    <button type="submit"
        class="btn btn-primary mt-4">
        Créer
    </button>
{{ form_end(form) }}

{% endblock %}
